+def probe_sdpa_backends(torch, dtype):
+    """Sonde v7 : les backends mem_efficient / flash de SDPA sont-ils
+    disponibles pour CE dtype sur CE GPU ? Sur T4 + bf16 non (sm 7.5) : SDPA
+    retombe sur le backend MATH qui matérialise l'attention (cause de l'OOM
+    run 2 v6b). Purement informatif — le plan mémoire v7 (checkpointing +
+    micro-batch 2) tient MÊME en fallback math ; la sonde n'est jamais fatale."""
+    res = {"efficient_attention": None, "flash": None, "erreur": None,
+           "dtype": str(dtype)}
+    try:
+        import torch.nn.functional as F
+        from torch.nn.attention import SDPBackend, sdpa_kernel
+        bsz, heads, seq, dim = 2, 32, 512, 128
+        q = torch.randn(bsz, heads, seq, dim, device="cuda", dtype=dtype)
+        k = torch.randn(bsz, heads, seq, dim, device="cuda", dtype=dtype)
+        v = torch.randn(bsz, heads, seq, dim, device="cuda", dtype=dtype)
+        mask4d = torch.zeros(bsz, 1, seq, seq, device="cuda", dtype=dtype)
+        for key, backend in (
+                ("efficient_attention", SDPBackend.EFFICIENT_ATTENTION),
+                ("flash", SDPBackend.FLASH_ATTENTION)):
+            try:
+                with sdpa_kernel([backend]):
+                    F.scaled_dot_product_attention(q, k, v, attn_mask=mask4d)
+                res[key] = True
+            except Exception:                              # noqa: BLE001
+                res[key] = False
+        del q, k, v, mask4d
+        torch.cuda.empty_cache()
+    except Exception as exc:                                  # noqa: BLE001
+        res["erreur"] = f"{type(exc).__name__}: {exc}"
+    return res
+
