+    def dry_run_peak(seq_len):
+        """Forward+backward de référence (micro-batch BATCH_SIZE, seq fixée,
+        SANS step d'optimiseur) : pic VRAM du chemin backward, mesuré AVANT
+        puis APRÈS activation du gradient checkpointing — preuve v7 que le
+        pic baisse (v6b : OOM au 1er batch batch 4, sans checkpointing)."""
+        try:
+            torch.cuda.synchronize()
+            torch.cuda.reset_peak_memory_stats()
+            ids = torch.ones((BATCH_SIZE, seq_len), dtype=torch.long,
+                             device="cuda")
+            mask = torch.ones_like(ids)
+            out = model(input_ids=ids, attention_mask=mask, labels=ids.clone())
+            out.loss.backward()
+            torch.cuda.synchronize()
+            peak = round(torch.cuda.max_memory_allocated() / 1024**3, 2)
+            del out, ids, mask
+            return peak
+        except Exception as exc:                              # noqa: BLE001
+            return f"ÉCHEC {type(exc).__name__}"
+        finally:
+            model.zero_grad(set_to_none=True)
+            gc.collect()
+            torch.cuda.empty_cache()
+
