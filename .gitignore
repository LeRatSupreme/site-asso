# AEIC — fichiers à ignorer par Git
/config.env
/vendor/
/node_modules/

# Uploads & cache générés
/public/assets/uploads/*
!/public/assets/uploads/.gitkeep

# Logs
*.log
/logs/

# Cache (rate limiter, etc.)
/cache/

# Cache PHPUnit
/.phpunit.cache/
phpunit.phar

# Sauvegardes (scripts/backup.sh)
/backups/

# Sauvegardes base de données
/database/backup/

# Archives & exports
*.tgz
site_final.zip
Rapport-ventes-*.csv

# Factures privées scannées (jamais dans git)
Facture/
image_a_scan.jpg

# OS / éditeurs
.DS_Store
Thumbs.db
.idea/
.vscode/

# T1 — moteur de similarité (Lot B) : venv, cache modèle ONNX int8, bytecode Python
/.venv-t1/
/.venv-p2conv/
/.venv-assistant/
/data/eval_t1/.cache/
__pycache__/
.kilo/
tests/cache/
# T1.5 — quarantaine des fusions auto : état RUNTIME du VPS (jamais committé)
/data/eval_t1/t15/quarantaine.json
/data/eval_t1/t15/*.lock
/data/eval_t1/t15/*.tmp.*
/data/eval_t1/p2/**/*.onnx
/data/eval_t1/p2/**/*.safetensors
/data/eval_t1/p2/**/tokenizer.json
/data/eval_t1/p2/**/sentencepiece.bpe.model
/data/eval_t1/p2/_vendor_st570/
*.whl
# T4-P2 — préparation fine-tuning : modèles/adapter binaires et corpus > 1 Mo (jamais dans git)
/data/eval_t1/t4p2/base_model_hf/
/data/eval_t1/t4p2/kernel_output_v5/adapter/adapter_model.safetensors
/data/eval_t1/t4p2/tests_local/micro_model/
/data/eval_t1/t4p2/tests_local/out_micro/adapter/adapter_model.safetensors
/data/eval_t1/t4p2/corpus/train.jsonl
/data/eval_t1/t4p2/kaggle_upload/train.jsonl
/data/eval_t1/t4p2/kaggle_upload/train.csv
# P2-auto — état runtime, CSV/feedback et runs de la boucle (jamais dans git ; seuls les petits manifestes documentés seraient à committer manuellement)
/data/eval_t1/p2/auto/
# T4-P2 full — entraînement kernel Kaggle : rapports/manifestes/metrics versionnés ;
# JAMAIS les binaires volumineux (GGUF 2,5 Go, adapter 47 Mo), logs kernels, .bak
/data/eval_t1/t4p2/full/**/*.gguf
/data/eval_t1/t4p2/full/**/adapter_model.safetensors
/data/eval_t1/t4p2/full/**/*.log
/data/eval_t1/t4p2/full/**/*.bak
/data/eval_t1/t4p2/full/**/__pycache__/
