# AEIC — fichiers à ignorer par Git
/config.env
/vendor/
/node_modules/

# Uploads & cache générés
/public/assets/uploads/*
!/public/assets/uploads/.gitkeep

# Logs
*.log
/logs/

# Cache (rate limiter, etc.)
/cache/

# Cache PHPUnit
/.phpunit.cache/

# Sauvegardes (scripts/backup.sh)
/backups/

# Sauvegardes base de données
/database/backup/

# Archives & exports
*.tgz
site_final.zip
Rapport-ventes-*.csv

# OS / éditeurs
.DS_Store
Thumbs.db
.idea/
.vscode/
tests/cache/
