# ============================================================
#  AEIC — Fichier de configuration par environnement
#  Copier ce fichier en "config.env" et renseigner les valeurs
#  de production. NE JAMAIS committer config.env (cf. .gitignore).
# ============================================================

# --- Base de données (MariaDB / MySQL) ---
DB_HOST=127.0.0.1
DB_NAME=aeic
DB_USER=aeic
DB_PASS=

# --- Application ---
# APP_ENV : dev | prod
APP_ENV=prod
# URL publique du site (sans slash final). Sert à générer les liens absolus.
APP_URL=https://asso.aremond.ovh
# Affiche les erreurs détaillées en dev (à false en prod).
APP_DEBUG=false
# Clé applicative (base64 de 32 octets) utilisée pour chiffrer les secrets en base.
# Générer une valeur : php -r "echo base64_encode(random_bytes(32));"
# APP_KEY=
# IP/CIDR des reverse proxy de confiance, séparés par des virgules
# (ex: "127.0.0.1,10.0.0.0/8"). Vide par défaut : X-Forwarded-For est ignoré.
# TRUSTED_PROXIES=

 # --- Groupe « Système » de l'admin (Utilisateurs, Paramètres) ---
 # Emails des ADMIN explicitement autorisés, séparés par des virgules
 # (ex: "admin1@asso.fr,admin2@asso.fr"). Comparaison insensible à la casse.
 # « Admin = tout voir » : vide ou absent = TOUS les ADMIN ont accès.
 # Renseignée, la liste restreint l'accès aux seuls emails listés.
 # SYSTEM_ADMINS=

# --- SumUp : synchro automatique des ventes (cron chaque minute) ---
# Clé API SumUp (me.sumup.com → Settings → For Developers → API Keys).
# Vide/absente = synchro désactivée. NE JAMAIS committer la vraie clé ici.
# SUMUP_API_KEY=
# Code marchand SumUp (merchant_profile.merchant_code dans /v0.1/me).
# Laisser vide : découvert automatiquement à la première exécution.
# SUMUP_MERCHANT_CODE=
# Fenêtre de recherche des ventes à chaque exécution, en heures (défaut 24).
# SUMUP_SYNC_LOOKBACK_HOURS=24

# --- E-mails / SMTP (optionnel : surcharge les settings « email » saisis en admin) ---
# Laisser vide pour utiliser les valeurs de la base (page Paramètres).
# SMTP_HOST=smtp.example.fr
# SMTP_PORT=587
# SMTP_ENCRYPTION=tls        # none | tls | ssl | (vide = auto)
# SMTP_USER=
# SMTP_PASS=
# MAILER_FROM=noreply@aeic.fr
# MAILER_FROM_NAME=AEIC

# --- GLM-OCR : moteur d'OCR cloud pour les photos du scan (optionnel) ---
# « Prendre une photo » (livre comptable, admin ET kiosque) essaie d'abord
# le moteur de vision GLM de Z.ai quand une clé est renseignée : bien meilleure
# lecture des tickets/factures photographiés. SANS clé — ou si l'API échoue
# (réseau, quota…) — l'OCR local Tesseract continue de fonctionner à l'identique.
# Créer la clé sur la plateforme Z.ai (https://z.ai, console API → API Keys).
# NB : avec une clé, les photos de factures transitent vers ce tiers (fournisseurs,
# montants) — traitement à documenter au registre RGPD de l'association.
# NE JAMAIS committer la vraie clé ici.
# GLM_OCR_API_KEY=
# URL de base de l'API (compatible OpenAI). Défaut si vide :
# https://api.z.ai/api/paas/v4
# GLM_OCR_BASE_URL=https://api.z.ai/api/paas/v4
# Nom du modèle vision. Défaut si vide : glm-ocr
# GLM_OCR_MODEL=glm-ocr
# Délai maximal d'un appel à l'API, en secondes. Défaut si vide : 75
# GLM_OCR_TIMEOUT_S=75
