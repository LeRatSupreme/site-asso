# ============================================================
#  AEIC — Fichier de configuration par environnement
#  Copier ce fichier en "config.env" et renseigner les valeurs
#  de production. NE JAMAIS committer config.env (cf. .gitignore).
# ============================================================

# --- Base de données (MariaDB / MySQL) ---
DB_HOST=127.0.0.1
DB_NAME=aeic
DB_USER=aeic
DB_PASS=

# --- Application ---
# APP_ENV : dev | prod
APP_ENV=prod
# URL publique du site (sans slash final). Sert à générer les liens absolus.
APP_URL=https://asso.aremond.ovh
# Affiche les erreurs détaillées en dev (à false en prod).
APP_DEBUG=false
# Clé applicative (base64 de 32 octets) utilisée pour chiffrer les secrets en base.
# Générer une valeur : php -r "echo base64_encode(random_bytes(32));"
# APP_KEY=
# IP/CIDR des reverse proxy de confiance, séparés par des virgules
# (ex: "127.0.0.1,10.0.0.0/8"). Vide par défaut : X-Forwarded-For est ignoré.
# TRUSTED_PROXIES=

# --- Groupe « Système » de l'admin (Utilisateurs, Paramètres) ---
# Emails des ADMIN explicitement autorisés, séparés par des virgules
# (ex: "admin1@asso.fr,admin2@asso.fr"). Comparaison insensible à la casse.
# ATTENTION : vide ou absent = AUCUN accès à Utilisateurs / Paramètres,
# même pour les ADMIN.
# SYSTEM_ADMINS=

# --- E-mails / SMTP (optionnel : surcharge les settings « email » saisis en admin) ---
# Laisser vide pour utiliser les valeurs de la base (page Paramètres).
# SMTP_HOST=smtp.example.fr
# SMTP_PORT=587
# SMTP_ENCRYPTION=tls        # none | tls | ssl | (vide = auto)
# SMTP_USER=
# SMTP_PASS=
# MAILER_FROM=noreply@aeic.fr
# MAILER_FROM_NAME=AEIC
